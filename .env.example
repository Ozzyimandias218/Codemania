# Server
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codemania?schema=public"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# Auth (JWT)
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Game & Commitment Configuration
MAX_LEVELS_PER_DAY=3
FINAL_EXAM_TIME_LIMIT_MINUTES=45
FINAL_EXAM_QUESTION_COUNT=20
ADMIN_EMAILS="admin@codemania.dev"

# Rate Limiting
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_ANSWER_WINDOW_MS=60000
RATE_LIMIT_ANSWER_MAX=60

# Stripe (only used when Commitment.mode != SIMULATED)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_SUCCESS_URL="http://localhost:3000/commitments/stripe/success"
STRIPE_CANCEL_URL="http://localhost:3000/commitments/stripe/cancel"

# Voice-Over / TTS (HuggingFace Inference Endpoint)
HF_ENDPOINT_URL=""
HF_TOKEN=""
TTS_DEFAULT_LANGUAGE="en"
TTS_DEFAULT_VOICE_ID="default"
AUDIO_PUBLIC_BASE_URL="http://localhost:3000/audio"

# Daily Quiz: "Aristotle"
DAILY_TZ="UTC"
DAILY_QUESTION_SECONDS=60
DAILY_BUFFER_DAYS=7
